{
  "name": "@pigknowsdev/date-helpers",
  "version": "2.0.2",
  "author": "PigKnows Dev",
  "type": "module",
  "license": "ISC",
  "homepage": "https://github.com/pigknows/pk-date-helpers#readme",
  "description": "date conversions used throughout pigknows products",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pigknows/pk-date-helpers.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "node",
    "date",
    "conversions"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "luxon": "^3.4.4"
  },
  "devDependencies": {
    "@babel/core": "^7.11.6",
    "@babel/preset-env": "^7.11.5",
    "@babel/preset-typescript": "^7.10.4",
    "@tsconfig/node12": "^1.0.7",
    "@tsconfig/recommended": "^1.0.1",
    "@types/luxon": "^3.4.2",
    "typescript": "^4.0.3"
  },
  "optionalDependencies": {
    "fsevents": "^2.1.3"
  }
}
