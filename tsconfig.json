{
    "extends": "@tsconfig/recommended/tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "outDir": "dist",
        "noImplicitAny": false,
        "sourceMap": true,
        "pretty": true,
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "target": "ES6",
        "lib": ["ES2019", "DOM"]
    },
    "include": [
        "src/index.ts"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts"
    ]
}